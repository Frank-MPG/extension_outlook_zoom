{
  "manifest_version": 3,
  "name": "Zoom trackpad pour Outlook",
  "version": "1.1.0",
  "description": "Pinch (zoom trackpad) sur un mail Outlook web : vrai zoom visuel de Chrome au lieu de grossir la police.",
  "homepage_url": "https://github.com/frank-mpg/extension_outlook_zoom",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zoom trackpad pour Outlook"
  },
  "background": {
    "service_worker": "autoreload.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
